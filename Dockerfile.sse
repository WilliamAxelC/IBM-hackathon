# S1Gate Remote MCP Server (SSE / HTTP)
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for rapid Python dependency resolution
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Copy project definition and source code
COPY pyproject.toml README.md ./
COPY src/ ./src/

# Install dependencies and package
RUN uv pip install --system --no-cache "." uvicorn starlette httpx

# Expose SSE / HTTP port
EXPOSE 8000

# Environment defaults
ENV PYTHONUNBUFFERED=1 \
    S1GATE_PORT=8000 \
    S1GATE_HOST=0.0.0.0

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["python", "-m", "kevgate.sse_server", "--host", "0.0.0.0", "--port", "8000"]
