# S1Gate Configuration
# Backend selector: gemini (default for MVP), lmstudio (local offline GPU)
S1GATE_BACKEND=gemini

# Google AI Studio API Key (Free tier: 15 RPM / 1M TPM)
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Local LM Studio Configuration (Optional for offline GPU execution)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen2.5-coder-3b-instruct

# IBM Bob API Key (Hackathon Instance)
# Generated from: https://bob.ibm.com/admin/subscription
# BOB_API_KEY=your_bob_api_key_here
