+def fetch_user_data(user_id: str, timeout_sec: int = 30, **kwargs) -> dict:
+    """Fetch user profile with backward-compatible argument translation."""
+    # Checks for legacy 'timeout' argument and maps it seamlessly
+    if "timeout" in kwargs:
+        warnings.warn(
+            "Argument 'timeout' is deprecated; use 'timeout_sec' instead.",
+            DeprecationWarning,
+            stacklevel=2,
+        )
+        timeout_sec = kwargs.pop("timeout")
+    return {"id": user_id, "timeout": timeout_sec}
